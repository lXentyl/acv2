# ============================================================
# ACV2 Print – Environment Configuration
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=acv2admin
DB_PASSWORD=secure_password_change_me
DB_NAME=acv2print

# JWT Secrets (change in production!)
JWT_SECRET=acv2-secret-key-change-in-production
JWT_REFRESH_SECRET=acv2-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api
